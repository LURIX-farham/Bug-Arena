# Backend (PHP / MySQL)
BUGARENA_ENV=local
BUGARENA_DEBUG=1
BUGARENA_DB_HOST=127.0.0.1
BUGARENA_DB_PORT=3306
BUGARENA_DB_NAME=bug_arena
BUGARENA_DB_USER=root
BUGARENA_DB_PASSWORD=

# 1 = auto-create database + import schema/seed on first request (local only)
# 0 = connect only; the database must already exist
BUGARENA_AUTO_SETUP=1
BUGARENA_SESSION_LIFETIME=7200

# Comma-separated browser origins allowed to use credentialed API requests.
BUGARENA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,http://localhost,http://127.0.0.1

# Frontend API. Change the folder name if your WAMP project directory differs.
VITE_API_BASE_URL=http://localhost/BugArena-v1.9.0/backend/public

# Optional remote Python runner (empty = local subprocess isolation).
# Shared hosting / production should point this at an isolated runner service.
BUGARENA_PYTHON_RUNNER_URL=
BUGARENA_EXEC_TIMEOUT=8
BUGARENA_EXEC_MEMORY_MB=128
