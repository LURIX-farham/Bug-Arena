# =============================================================
# Bug Arena — local configuration (WAMP defaults).
# NEVER commit or upload this file with real secrets. On production set
# these values in the server's environment / hosting panel instead.
# =============================================================

BUGARENA_ENV=local
BUGARENA_DEBUG=1

# --- Database ---
BUGARENA_DB_HOST=127.0.0.1
BUGARENA_DB_PORT=3306
BUGARENA_DB_NAME=bugarena
BUGARENA_DB_USER=root
BUGARENA_DB_PASSWORD=

# 1 = create DB + import schema/seed on first run (local only)
BUGARENA_AUTO_SETUP=1

BUGARENA_SESSION_LIFETIME=7200

# --- CORS: comma-separated list of allowed frontend origins ---
BUGARENA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Python execution ---
# Empty = run Python locally (needs proc_open + python3 on the host).
# Shared hosting usually cannot; point to an isolated runner instead
# (scripts/python_runner_server.py) and optionally set a token.
BUGARENA_PYTHON_RUNNER_URL=
BUGARENA_PYTHON_RUNNER_TOKEN=
# 1 = refuse scores that could not be verified on the server (recommended
# in production once a runner is available).
BUGARENA_REQUIRE_VERIFIED=0

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost/BugArena/backend/public
