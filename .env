# =============================================================
# Bug Arena — Backend configuration (WAMP defaults)
# ⚠️ این فایل با مقادیر استاندارد WAMP تنظیم شده است:
#    MySQL روی 127.0.0.1:3306 ، کاربر root بدون رمز عبور.
#    اگر رمز MySQL دارید، BUGARENA_DB_PASSWORD را تکمیل کنید.
# =============================================================

BUGARENA_ENV=local
BUGARENA_DEBUG=1

# --- Database (WAMP standard) ---
BUGARENA_DB_HOST=127.0.0.1
BUGARENA_DB_PORT=3306
BUGARENA_DB_NAME=bugare_bugarena
BUGARENA_DB_USER=bugare_LURIX
BUGARENA_DB_PASSWORD=farham2286049009

# 1 = ساخت خودکار دیتابیس + import خودکار schema و seed در اولین اجرا
# 0 = فقط اتصال؛ دیتابیس باید از قبل (phpMyAdmin) ساخته شده باشد
BUGARENA_AUTO_SETUP=0

# --- Sessions ---
BUGARENA_SESSION_LIFETIME=7200

# --- CORS: مرورگرهای مجاز برای فراخوانی API ---
BUGARENA_CORS_ORIGINS=https://bugarena.ir,https://www.bugarena.ir
VITE_API_BASE_URL=https://bugarena.ir/api
